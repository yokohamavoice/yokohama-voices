{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "yokohama-voices",
  "main": "./worker.ts",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "triggers": { "crons": ["0 18 * * *"] },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "yokohama-voices",
    "database_id": "2f2efc3c-ed89-4e78-b3ea-ff341b994d29",
    "migrations_dir": "drizzle"
  }],
  "r2_buckets": [{
    "binding": "BUCKET",
    "bucket_name": "yokohama-voices-private"
  }],
  "vars": {
    "MODERATION_REPOSITORY": "yokohamavoice/yokohama-voices-moderation"
  },
  "observability": { "enabled": true }
}
